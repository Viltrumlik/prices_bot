# Needs Python 3.11+ (asyncio.timeout). Ubuntu 22.04's system python3 is 3.10,
# where this installs and imports fine and then fails on the first tick — so name
# the version explicitly if the host is older than 24.04.
#
#   cd /home/viltrumlik
#   git clone https://github.com/Viltrumlik/prices_bot.git
#   cd prices_bot
#   python3 -m venv venv && venv/bin/pip install -r requirements.txt
#   cp .env.example .env && "$EDITOR" .env       # BOT_TOKEN + CHAT_ID
#   chmod 600 .env
#   chown -R guts:guts /home/viltrumlik/prices_bot
#   cp deploy/prices-bot.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now prices-bot
#   journalctl -u prices-bot -f

[Unit]
Description=Prices Bot — BTC and TON (Gram) prices to a Telegram channel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guts
Group=guts
WorkingDirectory=/home/viltrumlik/prices_bot
ExecStart=/home/viltrumlik/prices_bot/venv/bin/python /home/viltrumlik/prices_bot/bot.py
Restart=always
RestartSec=10
# .env in WorkingDirectory is loaded by python-dotenv at startup.

[Install]
WantedBy=multi-user.target
