# Copy to .env and fill in. .env is gitignored — never commit it.
# A token that lands in a commit is burned: the only fix is /revoke in @BotFather.

# @BotFather -> /newbot
BOT_TOKEN=

# Numeric channel id, e.g. -1001234567890. With the bot already an admin, post
# something in the channel, then read result[].channel_post.chat.id from:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
# Use the number, not @username — a username can be changed at any time and
# would break the bot silently.
CHAT_ID=

# Seconds between posts.
POLL_SECONDS=180

# Exit (so the supervisor restarts us) if no tick has succeeded in this long.
# Must be 0 (disabled) or at least twice POLL_SECONDS.
WATCHDOG_SECONDS=1800

# 0 = post every tick. Raise it to only post when a coin has moved at least this
# many percent since the last post — 480 messages/day is a lot of notifications.
MIN_CHANGE_PCT=0

# Reject a provider whose data is older than this many seconds.
STALE_AFTER=300

# Reject a provider whose price moved more than this percent since the previous
# tick — a frozen or garbage feed usually shows up as a big step. Only applied
# while the previous tick is recent, so a real crash delays one post, not all of
# them.
MAX_JUMP_PCT=20
